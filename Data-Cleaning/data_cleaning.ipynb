
# ============================================================
# Global Superstore - Data Cleaning and MySQL Import
# ============================================================

import pandas as pd
import getpass

from sqlalchemy import create_engine, URL
from sqlalchemy.types import (
    VARCHAR,
    DECIMAL,
    DATE,
    INTEGER
)

# ------------------------------------------------------------
# 1. Load the dataset
# ------------------------------------------------------------

file_path = input("Enter the full path of the Excel file: ")

df = pd.read_excel(
    file_path,
    sheet_name="superstore",
    engine="openpyxl"
)

print("Original Dataset Shape:", df.shape)


# ------------------------------------------------------------
# 2. Remove the corrupted / unnecessary column
# ------------------------------------------------------------

unwanted_column = "è®°å½•æ•°"

if unwanted_column in df.columns:
    df = df.drop(columns=[unwanted_column])

print("Dataset Shape After Column Removal:", df.shape)


# ------------------------------------------------------------
# 3. Standardise column names
# ------------------------------------------------------------

df.columns = (
    df.columns
    .str.strip()
    .str.lower()
    .str.replace(r"[^a-z0-9]+", "_", regex=True)
    .str.strip("_")
)

print("\nStandardised Columns:")
print(df.columns.tolist())


# ------------------------------------------------------------
# 4. Convert date columns
# ------------------------------------------------------------

df["order_date"] = pd.to_datetime(
    df["order_date"],
    errors="coerce"
)

df["ship_date"] = pd.to_datetime(
    df["ship_date"],
    errors="coerce"
)

# Convert dates to Python date values for MySQL
df["order_date"] = df["order_date"].dt.date
df["ship_date"] = df["ship_date"].dt.date


# ------------------------------------------------------------
# 5. Check data quality
# ------------------------------------------------------------

print("\nFinal Dataset Shape:", df.shape)

print("\nMissing Values:")
print(df.isnull().sum().sum())

print("\nDuplicate Records:")
print(df.duplicated().sum())

print("\nData Types:")
print(df.dtypes)


# ------------------------------------------------------------
# 6. Connect to MySQL
# ------------------------------------------------------------

mysql_password = getpass.getpass("Enter MySQL password: ")

connection_url = URL.create(
    drivername="mysql+pymysql",
    username="root",
    password=mysql_password,
    host="localhost",
    port=3306,
    database="global_superstore"
)

engine = create_engine(connection_url)

# Test database connection
with engine.connect() as connection:
    print("\nMySQL connection successful!")


# ------------------------------------------------------------
# 7. Configure MySQL column data types
# ------------------------------------------------------------

sql_types = {
    "category": VARCHAR(50),
    "city": VARCHAR(100),
    "country": VARCHAR(100),
    "customer_id": VARCHAR(50),
    "customer_name": VARCHAR(150),
    "discount": DECIMAL(10, 2),
    "market": VARCHAR(50),
    "order_date": DATE,
    "order_id": VARCHAR(50),
    "order_priority": VARCHAR(50),
    "product_id": VARCHAR(50),
    "product_name": VARCHAR(255),
    "profit": DECIMAL(15, 2),
    "quantity": INTEGER,
    "region": VARCHAR(100),
    "row_id": INTEGER,
    "sales": DECIMAL(15, 2),
    "segment": VARCHAR(50),
    "ship_date": DATE,
    "ship_mode": VARCHAR(50),
    "shipping_cost": DECIMAL(10, 2),
    "state": VARCHAR(100),
    "sub_category": VARCHAR(100),
    "year": INTEGER,
    "market2": VARCHAR(50),
    "weeknum": INTEGER
}


# ------------------------------------------------------------
# 8. Import cleaned data into MySQL
# ------------------------------------------------------------

df.to_sql(
    name="orders",
    con=engine,
    if_exists="replace",
    index=False,
    dtype=sql_types,
    chunksize=1000,
    method="multi"
)

print("\nData imported successfully into MySQL!")
print("Table Name: orders")
print("Total Records Imported:", len(df))


# ------------------------------------------------------------
# 9. Close database connection
# ------------------------------------------------------------

engine.dispose()

print("\nData cleaning and import process completed.")
